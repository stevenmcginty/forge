node_modules/
out/
dist/
.vite/

# Packaging output (electron-builder) and the frozen dictation sidecar —
# 129 MB of PyInstaller, rebuilt with `npm run stt:build`.
release/
stt-dist/
.stt-build/
bridge-dist/

*.tsbuildinfo
*.log
.DS_Store

# Agent worktrees (Claude Code)
.claude/worktrees/

# Generated test audio for the dictation smoke test — regenerate with
# scripts/make-speech-wav.ps1 rather than carrying a WAV in the repo.
#
# The WAV, not the folder. `scripts/fixtures/` swallowed the hand-written
# entry points beside it — mobile-entry.ts and tunnel-entry.ts, which are what
# mobile:smoke and tunnel:check bundle to reach the real modules — so both
# checks were unrunnable from a clean clone while passing perfectly here.
scripts/fixtures/*.wav

# Temp probe files written into the root by scripts/bridge-register-check.mjs
.bridge-check-*.cjs

# Steve's own Firebase project id for the companion — created by
# `firebase use --alias default forge-sync`. The shape is in
# companion/.firebaserc.example; the id itself is his, not the repo's.
companion/.firebaserc
# Emulator state, if anyone ever runs with --export-on-exit
companion/.emulator-data/

# Throwaway FORGE_DATA_DIR for live UI checks — never a real install.
isolated/

# Which %APPDATA% profile THIS checkout runs against — one line, e.g.
# "Forge Dev". A checkout without it gets %APPDATA%\Forge, the real data.
#
# It has to be untracked. The development and stable checkouts share every
# tracked file, so any redirect written into tracked code (a path in the
# launcher, an app.isPackaged test in store.ts) reaches stable on the next
# pull and opens the everyday app on an empty profile. This file is the one
# thing that stays behind.
.forge-profile

# Forge Mobile APK. Built artefacts land in dist-apk/; the Android tree keeps
# its machine-local SDK pointer and build output out of the repo. The release
# keystore lives in %APPDATA%\Forge\android and must NEVER be committed — it
# is the only key that can ever ship an update to an installed Forge Mobile,
# so the ignore covers the whole class of key material, not one filename.
dist-apk/
mobile/android/local.properties
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/app/src/main/assets/public/
mobile/android/app/src/main/assets/capacitor.config.json
mobile/android/app/src/main/assets/capacitor.plugins.json
*.jks
*.keystore
keystore.properties
__pycache__/
