{
  "name": "forge",
  "version": "0.3.0",
  "private": true,
  "description": "Forge — an agentic development environment for Windows",
  "author": "Steve",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/predev-cleanup.mjs && node scripts/whats-new.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "electron-vite preview",
    "pretypecheck": "node scripts/whats-new.mjs",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json && tsc --noEmit --composite false -p tsconfig.mobile.json && tsc --noEmit --composite false -p tsconfig.webclient.json",
    "build": "npm run typecheck && electron-vite build",
    "icon": "node scripts/make-icon.mjs",
    "stt:build": "node scripts/build-stt.mjs",
    "secrets:audit": "node scripts/secrets-audit.mjs",
    "dist": "npm run build && node scripts/build-stt.mjs && node scripts/build-bridge.mjs && node scripts/make-icon.mjs && electron-builder && node scripts/secrets-audit.mjs --packed",
    "dist:nostt": "npm run build && node scripts/build-stt.mjs --optional && node scripts/build-bridge.mjs && node scripts/make-icon.mjs && electron-builder && node scripts/secrets-audit.mjs --packed",
    "release": "node scripts/release.mjs",
    "pty:smoke": "node scripts/pty-smoke.mjs",
    "shots:smoke": "node scripts/shots-smoke.mjs",
    "stt:manager": "node scripts/stt-manager-test.mjs",
    "stt:download": "node scripts/stt-download-test.mjs",
    "voice:check": "node scripts/voice-check.mjs",
    "voice:brain": "node scripts/voice-brain-smoke.mjs",
    "voice:luna": "node scripts/voice-luna-smoke.mjs",
    "memory:smoke": "node scripts/memory-smoke.mjs",
    "skills:smoke": "node scripts/skills-smoke.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "bridge:smoke": "node scripts/bridge-smoke.mjs",
    "bridge:register": "node scripts/bridge-register-check.mjs",
    "bridge:build": "node scripts/build-bridge.mjs",
    "remote:check": "node scripts/remote-check.mjs",
    "session:check": "node scripts/session-check.mjs",
    "packaged:check": "node scripts/packaged-check.mjs",
    "secrets:test": "node scripts/secrets-audit-test.mjs",
    "theme:check": "node scripts/theme-check.mjs",
    "updates:check": "node scripts/updates-check.mjs",
    "agents:check": "node scripts/agents-check.mjs",
    "commands:check": "node scripts/commands-check.mjs",
    "mosaic:check": "node scripts/mosaic-check.mjs",
    "rail:check": "node scripts/rail-check.mjs",
    "git:check": "node scripts/git-check.mjs",
    "gitwatch:smoke": "node scripts/gitwatch-smoke.mjs",
    "gh:check": "node scripts/gh-check.mjs",
    "tail:check": "node scripts/tail-check.mjs",
    "activity:check": "node scripts/activity-check.mjs",
    "share:check": "node scripts/share-check.mjs",
    "whatsnew": "node scripts/whats-new.mjs",
    "draft:check": "node scripts/draft-check.mjs",
    "hub:check": "node scripts/hub-check.mjs",
    "companion:smoke": "node scripts/companion-smoke.mjs",
    "web:rendezvous": "node scripts/web-rendezvous-check.mjs",
    "companion:icons": "node scripts/companion-icons.mjs",
    "companion:serve": "node scripts/companion-serve.mjs",
    "mobile:auth": "node scripts/mobile-auth-check.mjs",
    "mobile:smoke": "node scripts/mobile-smoke.mjs",
    "web:auth": "node scripts/web-auth-check.mjs",
    "web:smoke": "node scripts/web-smoke.mjs",
    "web:check": "node scripts/web-check.mjs",
    "web:e2e": "node scripts/web-e2e.mjs",
    "web:offline": "node scripts/web-offline.mjs",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:deploy": "npm run web:build && firebase deploy --only hosting:web",
    "mirror:check": "node scripts/mirror-check.mjs",
    "input:check": "node scripts/input-check.mjs",
    "mobile:icons": "node scripts/mobile-icons.mjs",
    "pwa:check": "node scripts/pwa-check.mjs",
    "mobile:dev": "vite --config mobile/vite.config.ts",
    "mobile:build": "vite build --config mobile/vite.config.ts",
    "mobile:serve": "node scripts/mobile-serve.mjs",
    "mobile:tunnel": "node scripts/mobile-tunnel.mjs",
    "mobile:go": "node scripts/mobile-go.mjs",
    "tunnel:check": "node scripts/tunnel-check.mjs",
    "apk:init": "node scripts/apk-init.mjs",
    "apk:build": "node scripts/apk-build.mjs",
    "apk:release": "node scripts/apk-release.mjs",
    "apk:ship": "node scripts/apk-ship.mjs",
    "apk:check": "node scripts/apk-check.mjs",
    "apk:tv": "node scripts/apk-tv-build.mjs",
    "apk:tv:release": "node scripts/apk-tv-release.mjs",
    "discovery:check": "node scripts/discovery-check.mjs",
    "tv-fetch:check": "node scripts/tv-fetch-check.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capacitor/preferences": "^7.0.4",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "firebase-tools": "^15.25.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@capacitor/barcode-scanner": "^2.2.6",
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  }
}
