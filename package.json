{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "Forge — an agentic development environment for Windows",
  "author": "Steve",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "icon": "node scripts/make-icon.mjs",
    "stt:build": "node scripts/build-stt.mjs",
    "secrets:audit": "node scripts/secrets-audit.mjs",
    "dist": "npm run build && node scripts/build-stt.mjs && node scripts/build-bridge.mjs && node scripts/make-icon.mjs && electron-builder && node scripts/secrets-audit.mjs --packed",
    "dist:nostt": "npm run build && node scripts/build-stt.mjs --optional && node scripts/build-bridge.mjs && node scripts/make-icon.mjs && electron-builder && node scripts/secrets-audit.mjs --packed",
    "pty:smoke": "node scripts/pty-smoke.mjs",
    "shots:smoke": "node scripts/shots-smoke.mjs",
    "stt:manager": "node scripts/stt-manager-test.mjs",
    "stt:download": "node scripts/stt-download-test.mjs",
    "voice:check": "node scripts/voice-check.mjs",
    "memory:smoke": "node scripts/memory-smoke.mjs",
    "bridge:smoke": "node scripts/bridge-smoke.mjs",
    "bridge:register": "node scripts/bridge-register-check.mjs",
    "bridge:build": "node scripts/build-bridge.mjs",
    "remote:check": "node scripts/remote-check.mjs",
    "packaged:check": "node scripts/packaged-check.mjs",
    "secrets:test": "node scripts/secrets-audit-test.mjs",
    "theme:check": "node scripts/theme-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.14",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
