{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["mobile/**/*.ts", "mobile/**/*.tsx", "shared/**/*.ts", "mobile/vite.config.ts"],
  "exclude": ["mobile/dist", "mobile/android"]
}
